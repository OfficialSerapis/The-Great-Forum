{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "commonjs",
    "target": "es2020",
    "outDir": "../dist/test",
    "rootDir": ".",
    "strict": true,
    "types": ["jest", "node"],
    "moduleResolution": "node"
  },
  "include": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "setup.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
