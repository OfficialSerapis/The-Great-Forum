# API Configuration
VITE_API_URL=http://localhost:3000

# Authentication
VITE_AUTH_SECRET=your_auth_secret

# Storage
VITE_STORAGE_URL=http://localhost:3000/uploads

# Analytics
VITE_ANALYTICS_ID=your_analytics_id

# Features
VITE_ENABLE_DEBUG_MODE=true
VITE_ENABLE_FEATURE_X=true
VITE_ENABLE_FEATURE_Y=true

# Performance
VITE_CACHE_TTL=3600
VITE_MAX_REQUESTS=100

# UI
VITE_THEME=light
VITE_FONT_FAMILY=system-ui

# Security
VITE_CSRF_TOKEN=your_csrf_token
VITE_CORS_ORIGIN=http://localhost:3000
