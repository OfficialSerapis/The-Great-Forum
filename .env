# Shared Configuration
SHARED_VERSION=1.0.0

# Feature Flags
SHARED_ENABLE_DARK_MODE=true
SHARED_ENABLE_NOTIFICATIONS=true
SHARED_ENABLE_EMOJI=true

# Performance
SHARED_CACHE_TTL=3600
SHARED_MAX_REQUESTS=100

# Security
SHARED_CSRF_TOKEN=your_csrf_token
SHARED_CORS_ORIGIN=http://localhost:3000

# Analytics
SHARED_ANALYTICS_ID=your_analytics_id

# Storage
SHARED_UPLOAD_DIR=./uploads
SHARED_MAX_FILE_SIZE=5000000
SHARED_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Cache
SHARED_CACHE_TTL=3600
SHARED_CACHE_MAX=1000

# Logging
SHARED_LOG_LEVEL=debug
SHARED_LOG_DIR=./logs
